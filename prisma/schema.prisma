// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// prisma를 통해 사용할 DB source 종류를 기록
datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

// 이 아랫부분에는 내가 실제 데이터베이스에 사용할 모델링을 기재 -> prisma의 문법을 통해

enum GenderType {
  MALE
  FEMALE
}

enum RoleType {
  ADMIN
  USER
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

// model 키워드는 Javascript에서는 객체가 되며, DB에서는 테이블이 됨
// 이 안에 기재하는 건, [칼럼명] [타입] [옵션] 으로 작성하고
// 옵션 -----
// @id : primary key
// @default : default
// @unique : unique
// @updatedAt : 해당 칼럼이 수정될 때 자동으로 들어가는 수정 시간 갱신 옵션
model User {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now()) // 삽입할 때 기본값으로 삽입 시간이 기록
  updatedAt   DateTime   @updatedAt // 수정할 때 기본적으로 수정 시간이 기록
  deletedAt   DateTime? // 타입에 ? 를 넣으면 null을 허용한다는 뜻
  username    String     @unique
  password    String
  name        String
  nickname    String     @unique
  email       String     @unique
  phoneNumber String?
  birthdate   DateTime?
  gender      GenderType
  role        RoleType   @default(USER) // 삽입할 때 기본값으로 USER 기록

  posts     Post[]
  votes     Vote[]
  replies   Reply[]
  inquiries Inquiry[]
}

model Category {
  id        Int            @id @default(autoincrement())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  name      String         @unique
  status    CategoryStatus @default(ACTIVE)

  posts Post[]
}

// Post 테이블과 다른 테이블의 연관성을 생각 해봐야 함
// 해당 데이터를 삭제해도 될 때에는, 1. 자식 테이블이 없을 때 (연관성이 아예 존재치 않을 때)
// 2. 자식 테이블까지 고려했을 때에도 중요하지 않을 때
// Post의 경우 Replies나, Like 등 테이블과 연관성이 있다고 판단하더라도
// 삭제해도 괜찮은 데이터들임 => 소프트삭제를 하든, 진짜 삭제 처리를 하든, 문제는 없을 것이다라고 가정
// 1번이든 2번이든 진행하는건 내 맘이다
// Prisma에서는 부모 데이터가 삭제되면, 자식 데이터까지 모두 삭제하는 기능을 제공
model Post {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  title       String
  content     String    @db.Text
  views       Int       @default(0)
  option1Text String? // 값이 없을 수 있다 => null
  option2Text String?

  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  // 이렇게 쓰는 것은 부모쪽 임 부모쪽에서는 가상 칼럼, 단지 우리가 조회를 할때 3번글이 거기에 해당하는 글이 있는지 Join을 해온다
  votes      Vote[]
  replies    Reply[]

  @@index([userId])
  @@index([categoryId])
}

// User와 Post에 대한 자식 테이블 임 Post가 없다면
// 투표에 대한것
model Vote {
  id        Int      @id @default(autoincrement()) // Pk 자동으로 unique가 걸려 있음
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  option    Int // 몇 번에 투표했는지
  // Post에 자식, User에 자식
  userId    Int // 부모 유저를 찾을 수 있도록 하는 id값이 "실제 기록"되는 칼럼
  user      User     @relation(fields: [userId], references: [id])
  // 부모 글을 찾을 수 있도록 하는 id값이 "실제 기록"되는 칼럼
  postId    Int
  // 실제 내용이 포스트 칼럼에 들어온다. 데이터베이스존재 없는 가상 칼럼으로 존재한다.
  post      Post     @relation(fields: [postId], references: [id])

  // 데이터베이스는 데이터에 대한 저장을 담당하고, 그 데이터를 검색해 주는 장치
  // 빠르게 검색을 도와주는 도구로서 index라는게 존재함

  // 나중에 마이페이지를 만들 때 "내가 투표한 거"를 찾아달라고 이야기 할 것이고
  // 게시글 상세 페이지에서 postId를 기준으로 검색을 해야되니까.
  // 사실, PK든, FK든 key는 index를 걸어야 함

  // 투표라고 하는건, 1인 1투표를 기초로 함
  // userId에 unique를 걸면 그 사람은 모든 글을 통틀어 1번만 투표가 가능해짐
  // postId에 unique를 걸면 모든 사람들 중 그 글에는 1번만 투표가 가능해짐
  // 그래서 userId와 postId에 동시에 unique를 걸어야 함
  @@unique([userId, postId])
  // 모든 칼럼에 대해 색인을 만들 필요는 없음. 전화번호에 "ㄱ,ㄴ,ㄷ"로 만들지, "김,이,최"로 만들진 않음
  // 오히려 색인이 많아지면 데이터베이스가 해야할 일이 많아질 뿐
  // 데이터베이스는 기본적으로 검색할 때 id(primary key)와 unique를 걸어준 것에 대해 색인을 만듦
  @@index([postId]) // foreign key
  @@index([userId]) // foreing key
}

model Reply {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   String   @db.Text

  userId Int
  user   User @relation(fields: [userId], references: [id])
  postId Int
  post   Post @relation(fields: [postId], references: [id])

  @@index([userId])
  @@index([postId])
}

// 데이터베이스 "(SQL 데이터베이스) 의  칼럼에 값은 1개 값만 들어갈 수 있음"
// 그렇게 적은 Reply 테이블의 user라는 항목(칼럼) 과 post 라는 항목(칼럼)의 타입을 객체 타임
// 즉, user와 post라는 항목의 타입인 객체는 데이터베이스에 들어갈수 없음
// 재네는 userId값을 가지고 User 테이블에서 데이터를 겁색해와서 Prisma가 넣어주는 (JOIN) 항목임

// 데이터베이스를 놓고   => Prisma
// MariaDB  => Prisma를 사용함
// mongoDB   => Prisma를 사용함

// SQL에서는 조회할 때 SQL(Query) => SELECT를 쓰잖아요?
// NoSQL에서는 조회할 때 어떻게 조회해요?

// mongoDB 라는 애는 조회를 하는 프로그램(Javasdript)이 내장
// mongoDB 자체를 쓸때도, post.findFirst()명령을 쓰면됨  > mongoDB 프로그램을 보고 prisma가 만들어졌음

// SQL 데이터베이스는 정형화된 데이트를 기반으로 하는 내용을 담당 (User 같음, Payment)
// NoSQL 데이터베이스는 데이터를 빠르게 저장하는 내용을 담당  (Log, 조회수, Like 같은)

// NoSQL은 칼럼에 객체, Array가 저장 가능  : 선택적 Relation
// User - Post(Vote 칼럼을 포함시켜서 Array 저장)
// SQL은 칼렁메 1개의 값만 저장 가능 : 무조건 Relation

model Notice {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String   @db.Text

  // Post에는 글쓴이가 필요하니까 User와 관계를 맺었지만, Notice는 관계를 맺지 않아도 됨
}

model Inquiry {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  title      String // 사용자가 문의를 할 때 남겨야 되는 것
  content    String // 사용자가 문의를 할 때 남겨야 되는 것
  answer     String?
  answeredAt DateTime?

  // 사용자가 문의를 남길 때에 필요한 정보는 title, content     => create를 할 것임
  // 관리자가 문의 답변을 남길 때에는 answer를 받아서   => 지금 현재시간을 추가해서 update를 할 것임

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([userId])
}
